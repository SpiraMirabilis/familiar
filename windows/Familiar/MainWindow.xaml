<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Familiar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Familiar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            AddTabButtonClick="OnAddTab"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelected"
            CanReorderTabs="True"
            CloseButtonOverlayMode="OnPointerOver">
            <TabView.TabStripHeader>
                <Image Source="familiar.ico" Width="16" Height="16" Margin="12,0,4,0" VerticalAlignment="Center" />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="Footer" ColumnDefinitions="*,Auto">
                    <Grid x:Name="DragRegion" Background="Transparent" MinWidth="48" />
                    <Button
                        x:Name="MenuButton"
                        Grid.Column="1"
                        Style="{ThemeResource CommandBarFlyoutEllipsisButtonStyle}"
                        Width="40"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Menu"
                        ToolTipService.ToolTip="Menu">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="Menu" Placement="BottomEdgeAlignedRight" Opening="OnMenuOpening">
                                <!-- Each item's Tag is the action it runs (keymap.rs), which also gives it its key. -->
                                <MenuFlyoutItem Text="Connect…" Tag="connect" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ReconnectItem" Text="Reconnect" Tag="reconnect" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DisconnectItem" Text="Disconnect" Tag="disconnect" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF384;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="FindItem" Text="Find…" Tag="find" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ClearItem" Text="Clear Output" Tag="clear" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="LogItem" Text="Log to File" Tag="toggle-log" Click="OnMenuItem" />
                                <MenuFlyoutItem Text="Open Log Folder" Tag="open-logs" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Stop Speaking" Tag="stop-speech" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Command Palette…" Tag="palette" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Triggers, Aliases &amp; Macros" Tag="rules" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Settings" Tag="preferences" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Import from BeipMU…" Tag="import-beipmu" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Keyboard Shortcuts" Tag="keyboard" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Help" Tag="help" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="About Familiar" Tag="about" Click="OnMenuItem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </TabView.TabStripFooter>
        </TabView>

    </Grid>
</Window>
