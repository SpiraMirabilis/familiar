<?xml version="1.0" encoding="UTF-8"?>
<!--
  MOO as accepted by the Stunt server in ~/stunt: LambdaMOO plus try/except, break/continue,
  maps, bitwise operators, /* comments */, $#colour literals, b"bytes" literals and string
  escapes. Built from parser.y's next_token() and keywords.gperf. The built-in function list
  is every register_function() name in the Stunt source (209 of them).

  MOO keywords and names are case-insensitive (gperf builds keywords.gperf with its ignore-case option).
-->
<language id="moo" name="MOO (Stunt)" version="2.0" _section="Source">
  <metadata>
    <property name="globs">*.moo</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="escape" name="Escape" map-to="def:special-char"/>
    <style id="bytes" name="Bytes Literal" map-to="def:string"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="error-code" name="Error Code" map-to="def:constant"/>
    <style id="object" name="Object Number" map-to="def:special-constant"/>
    <style id="colour" name="Colour Literal" map-to="def:special-constant"/>
    <style id="sysref" name="$ Reference" map-to="def:type"/>
    <style id="integer" name="Integer" map-to="def:decimal"/>
    <style id="float" name="Float" map-to="def:floating-point"/>
    <style id="builtin" name="Built-in Function" map-to="def:builtin"/>
    <style id="type-name" name="Type Constant" map-to="def:type"/>
    <style id="variable" name="Built-in Variable" map-to="def:special-constant"/>
    <style id="verb" name="Verb Call" map-to="def:function"/>
    <style id="operator" name="Operator" map-to="def:operator"/>
  </styles>

  <default-regex-options case-sensitive="false"/>

  <definitions>
    <!-- MOO has no line comments; by convention a statement that is only a string is one. -->
    <context id="string-statement" style-ref="comment" class="comment">
      <match>^\s*"(?:\\.|[^"\\])*"\s*;\s*$</match>
    </context>

    <context id="block-comment" style-ref="comment" class="comment" class-disabled="no-spell-check">
      <start>/\*</start>
      <end>\*/</end>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="escape" style-ref="escape">
      <match>\\(?:x[0-9a-f]{2}|u[0-9a-f]{4}|[nrte0"\\])</match>
    </context>

    <context id="string" style-ref="string" end-at-line-end="true" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <!-- Only a lowercase b starts a bytes literal. -->
    <context id="bytes" style-ref="bytes" end-at-line-end="true" class="string" class-disabled="no-spell-check">
      <start>(?-i)\bb"</start>
      <end>"</end>
      <include>
        <context ref="escape"/>
      </include>
    </context>

    <context id="colour" style-ref="colour">
      <match>\$#[a-z0-9_]+</match>
    </context>

    <context id="object" style-ref="object">
      <match>#-?[0-9]+</match>
    </context>

    <context id="sysref" style-ref="sysref">
      <match>\$[a-z_][a-z0-9_]*</match>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>elseif</keyword>
      <keyword>endif</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>endfor</keyword>
      <keyword>fork</keyword>
      <keyword>endfork</keyword>
      <keyword>return</keyword>
      <keyword>while</keyword>
      <keyword>endwhile</keyword>
      <keyword>try</keyword>
      <keyword>except</keyword>
      <keyword>finally</keyword>
      <keyword>endtry</keyword>
      <keyword>break</keyword>
      <keyword>continue</keyword>
      <keyword>ANY</keyword>
    </context>

    <!-- Built-in variables (sym_table.cc), but not as property or verb names like x.player. -->
    <context id="type-names" style-ref="type-name">
      <prefix>(?&lt;![.:$])\b</prefix>
      <keyword>NUM</keyword>
      <keyword>OBJ</keyword>
      <keyword>STR</keyword>
      <keyword>LIST</keyword>
      <keyword>ERR</keyword>
      <keyword>INT</keyword>
      <keyword>FLOAT</keyword>
      <keyword>MAP</keyword>
      <keyword>ANON</keyword>
      <keyword>BYTES</keyword>
      <keyword>COLOR</keyword>
    </context>

    <context id="variables" style-ref="variable">
      <prefix>(?&lt;![.:$])\b</prefix>
      <keyword>player</keyword>
      <keyword>this</keyword>
      <keyword>caller</keyword>
      <keyword>verb</keyword>
      <keyword>args</keyword>
      <keyword>argstr</keyword>
      <keyword>dobj</keyword>
      <keyword>dobjstr</keyword>
      <keyword>prepstr</keyword>
      <keyword>iobj</keyword>
      <keyword>iobjstr</keyword>
    </context>

    <context id="error-codes" style-ref="error-code">
      <keyword>E_NONE</keyword>
      <keyword>E_TYPE</keyword>
      <keyword>E_DIV</keyword>
      <keyword>E_PERM</keyword>
      <keyword>E_PROPNF</keyword>
      <keyword>E_VERBNF</keyword>
      <keyword>E_VARNF</keyword>
      <keyword>E_INVIND</keyword>
      <keyword>E_RECMOVE</keyword>
      <keyword>E_MAXREC</keyword>
      <keyword>E_RANGE</keyword>
      <keyword>E_ARGS</keyword>
      <keyword>E_NACC</keyword>
      <keyword>E_INVARG</keyword>
      <keyword>E_QUOTA</keyword>
      <keyword>E_FLOAT</keyword>
      <keyword>E_FILE</keyword>
      <keyword>E_EXEC</keyword>
      <keyword>E_INTRPT</keyword>
    </context>

    <!-- Built-in functions are only highlighted where they're called. -->
    <context id="builtins" style-ref="builtin">
      <suffix>(?=\s*\()</suffix>
      <keyword>abs</keyword>
      <keyword>acos</keyword>
      <keyword>add_property</keyword>
