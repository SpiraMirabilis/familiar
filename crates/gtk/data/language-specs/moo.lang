    <context id="verb-call" style-ref="verb">
      <match>(?&lt;=:)[a-z_][a-z0-9_]*(?=\s*\()</match>
    </context>

    <!-- 1.5, 1., .5 and 1e3, but not the 1 in the range 1..5. -->
    <context id="float" style-ref="float">
      <match>(?&lt;![a-z0-9_.$#])(?:[0-9]+\.[0-9]+(?:e[+-]?[0-9]+)?|[0-9]+\.(?![.0-9])(?:e[+-]?[0-9]+)?|\.[0-9]+(?:e[+-]?[0-9]+)?|[0-9]+e[+-]?[0-9]+)(?![a-z0-9_])</match>
    </context>

    <!-- Not after a single dot, but after .. as in x[1..5]. -->
    <context id="integer" style-ref="integer">
      <match>(?&lt;![a-z0-9_$#])(?:(?&lt;=\.\.)|(?&lt;!\.))[0-9]+(?![a-z0-9_])</match>
    </context>

    <context id="operators" style-ref="operator">
      <match>-&gt;|=&gt;|\.\.|&amp;&amp;|\|\||==|!=|&lt;=|&gt;=|&amp;\.|\|\.|\^\.|&lt;&lt;|&gt;&gt;|[-+*/%^!~&lt;&gt;=?|@`'$]</match>
    </context>

    <context id="moo" class="no-spell-check">
      <include>
        <context ref="string-statement"/>
        <context ref="block-comment"/>
        <context ref="bytes"/>
        <context ref="string"/>
        <context ref="colour"/>
        <context ref="object"/>
        <context ref="sysref"/>
        <context ref="keywords"/>
        <context ref="error-codes"/>
        <context ref="type-names"/>
        <context ref="variables"/>
        <context ref="builtins"/>
        <context ref="verb-call"/>
        <context ref="float"/>
        <context ref="integer"/>
        <context ref="operators"/>
      </include>
    </context>
  </definitions>
</language>
